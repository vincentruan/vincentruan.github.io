/* TTS Audio Player Styles — injected via NexT custom_file_path.style */

.tts-audio-player {
  --tts-bg: var(--content-bg, #f8f8f8);
  --tts-border: var(--border-color, #e0e0e0);
  --tts-text: var(--text-color, #333);
  --tts-accent: var(--theme-color, #2d91c7);
  --tts-muted: var(--TextColor-80, #999);

  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  margin: 20px 0;
  background: var(--tts-bg);
  border: 1px solid var(--tts-border);
  border-radius: 8px;
  font-family: system-ui, -apple-system, sans-serif;
  font-size: 14px;
  color: var(--tts-text);
}

.tts-player-icon {
  font-size: 18px;
  opacity: 0.6;
  flex-shrink: 0;
}

.tts-player-btn {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 18px;
  padding: 4px 8px;
  border-radius: 4px;
  color: var(--tts-text);
  transition: background 0.2s;
  flex-shrink: 0;
}

.tts-player-btn:hover {
  background: rgba(0, 0, 0, 0.05);
}

@media (prefers-color-scheme: dark) {
  .tts-player-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }
}

.tts-player-progress {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.tts-player-bar {
  flex: 1;
  height: 4px;
  -webkit-appearance: none;
  appearance: none;
  background: var(--tts-border);
  border-radius: 2px;
  outline: none;
  cursor: pointer;
}

.tts-player-bar::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--tts-accent);
  cursor: pointer;
  border: 2px solid var(--tts-bg);
  box-shadow: 0 0 2px rgba(0, 0, 0, 0.2);
}

.tts-player-bar::-moz-range-thumb {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--tts-accent);
  cursor: pointer;
  border: 2px solid var(--tts-bg);
  box-shadow: 0 0 2px rgba(0, 0, 0, 0.2);
}

.tts-player-time {
  font-size: 12px;
  color: var(--tts-muted);
  white-space: nowrap;
  flex-shrink: 0;
  min-width: 90px;
  text-align: center;
}

.tts-player-speed {
  background: none;
  border: 1px solid var(--tts-border);
  border-radius: 4px;
  padding: 2px 6px;
  font-size: 12px;
  color: var(--tts-text);
  cursor: pointer;
  flex-shrink: 0;
}

.tts-player-speed:hover {
  border-color: var(--tts-accent);
}

/* Responsive: stack on narrow screens */
@media (max-width: 500px) {
  .tts-audio-player {
    flex-wrap: wrap;
    gap: 8px;
    padding: 10px 12px;
  }

  .tts-player-progress {
    order: 10;
    width: 100%;
  }

  .tts-player-time {
    min-width: auto;
  }
}
